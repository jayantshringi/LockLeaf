# Set default behaviour to automatically normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.plist text eol=lf
*.swift text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.sql text eol=lf

# Declare binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.so binary
*.dylib binary
*.dll binary
